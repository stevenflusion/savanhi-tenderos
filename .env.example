# .env.example — copia este archivo a .env y completa los valores
# cp .env.example .env

# Supabase (obtén estos valores en Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
# Usa SUPABASE_ANON_KEY o SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Usa SUPABASE_SERVICE_ROLE_KEY o SUPABASE_SECRET_KEY (SOLO BACKEND)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# JWT para autenticación en los backends (genera uno seguro: openssl rand -base64 32)
AUTH_JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Opcional: puerto y orígenes CORS (coma-separados)
# PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8082

# Opcional: para crear admin de desarrollo automáticamente
# DEV_ADMIN_EMAIL=dev.admin@savanhi.local
# DEV_ADMIN_PASSWORD=ChangeMe123!
# DEV_ADMIN_FULL_NAME=Developer Admin

# Notas:
# - No subas tu archivo .env real al repositorio. Añade .env al .gitignore.
# - Para desarrollo: cp .env.example .env y edita los valores
# - Si usas Docker/CI, exporta estas variables en el entorno de ejecución.
# - SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY solo debe existir en backends.
# - PORT puede omitirse en .env raíz porque cada backend define su puerto por defecto.