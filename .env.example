# Opcional: puerto y orígenes CORS (coma-separados)
# PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8082

# Opcional: para crear admin de desarrollo automáticamente
# DEV_ADMIN_EMAIL=dev.admin@savanhi.local
# DEV_ADMIN_PASSWORD=ChangeMe123!
# DEV_ADMIN_FULL_NAME=Developer Admin

# Notas:
# - No subas tu archivo .env real al repositorio. Añade .env al .gitignore.
# - Para desarrollo: cp .env.example .env y edita los valores
# - Si usas Docker/CI, exporta estas variables en el entorno de ejecución.
DATABASE_URL=postgresql://savanhi:savanhi@localhost:5433/savanhi
AUTH_JWT_SECRET=change-this-development-secret
AUTH_JWT_ISSUER=savanhi-api
AUTH_JWT_AUDIENCE=savanhi-api
OTP_PROVIDER=development
# Only for local deterministic OTP tests. Never set in production.
OTP_DEV_CODE=
# Required only when OTP_PROVIDER=external. No provider is bundled.
OTP_EXTERNAL_URL=
OTP_EXTERNAL_API_KEY=
OTP_EXTERNAL_FROM=
OTP_EXTERNAL_TIMEOUT_MS=5000
TRUST_PROXY=false
OTP_PROVIDER=development
OTP_DEV_CODE=
RATE_LIMIT_API=120
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_OTP_REQUEST=5
RATE_LIMIT_OTP_VERIFY=10
RATE_LIMIT_REFRESH=30
# - PORT puede omitirse en .env raíz porque cada backend define su puerto por defecto.

TOKEN_GITHUB=<your-github-token>
